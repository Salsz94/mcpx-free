"""Small Windows control panel for the Resolve-local MCPX worker."""

import argparse
import json
import os
from pathlib import Path
import sys
import time
import tkinter as tk
from tkinter import filedialog, messagebox
from edit import safe_path


ROOT = Path(__file__).resolve().parent
BACKGROUND = "#101419"
SURFACE = "#1b222b"
TEXT = "#edf3f9"
MUTED = "#9caab9"
GREEN = "#60e2b1"


def activation_script(session):
    """Generate a fixed local entry point for Resolve's Scripts menu."""
    quote = lambda value: json.dumps(str(value).replace("\\", "/"), ensure_ascii=False)
    return "\n".join([
        "-- MCPX-Free local activation. Generated by launcher.pyw.",
        "local app = assert(fusion or fu)",
        "local directory = " + quote(session),
        'local failure = assert(app:OpenFile(directory .. "/worker-error.txt", 2))',
        'failure:WriteLine("")',
        "failure:Close()",
        "local ok, err = pcall(function()",
        'local r = assert(resolve or bmd.scriptapp("Resolve"))',
        "local manager = r:GetProjectManager()",
        "local project = manager:GetCurrentProject()",
        "local name = project and project:GetName()",
        'local armed = name and name:match("^MCPX%-TEST%-[%w%-]+$")',
        'app:SetData("MCPX.Directory", directory)',
        'app:SetData("MCPX.BridgeScript", ' + quote(ROOT / "bridge.lua") + ")",
        'app:SetData("MCPX.TestProject", armed and name or nil)',
        'app:SetData("MCPX.TestLibrary", armed and manager:GetCurrentDatabase().DbName or nil)',
        'local stop = assert(app:OpenFile(directory .. "/stop.txt", 2))',
        'stop:WriteLine("run")',
        "stop:Close()",
        "dofile(" + quote(ROOT / "worker.lua") + ")",
        "end)",
        "if not ok then",
        '    local failure = app:OpenFile(directory .. "/worker-error.txt", 2)',
        '    if failure then failure:WriteLine(tostring(err)); failure:Close() end',
        '    print("MCPX activation failed: " .. tostring(err))',
        "end",
        "",
    ])


def validate_session(path):
    path = path.resolve(strict=True)
    if not all((path / name).is_file() for name in ("request.txt", "response.txt", "lock")):
        raise ValueError("Elige la carpeta de sesión creada con new-session.ps1.")
    return path


def prepare_status_files(session):
    for name in ("heartbeat.txt", "stop.txt", "worker-error.txt", "context.txt"):
        try:
            with (session / name).open("xb"):
                pass
        except FileExistsError:
            safe_path(session, name)


def heartbeat_state(session):
    try:
        value = (session / "heartbeat.txt").read_text(encoding="ascii").strip()
        if value == "stopped":
            return False
        age = time.time() - int(value)
        return -2 <= age <= 4
    except (OSError, ValueError):
        return False


def worker_context(session):
    try:
        name, mode = (session / "context.txt").read_text(encoding="ascii").strip().split("|")
        if mode not in ("read", "test"):
            return "", ""
        return bytes.fromhex(name).decode("utf-8"), mode
    except (OSError, ValueError, UnicodeError):
        return "", ""


def install_menu(session):
    prepare_status_files(session)
    destination = (Path(os.environ["APPDATA"]) / "Blackmagic Design" /
                   "DaVinci Resolve/Support/Fusion/Scripts/Utility/MCPX Free.lua")
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.exists() and not destination.read_text(encoding="utf-8").startswith(
            "-- MCPX-Free local activation. Generated by launcher.pyw."):
        raise ValueError("Ya existe un script MCPX Free.lua ajeno al instalador. Revise ese archivo.")
    temporary = destination.with_suffix(".tmp")
    temporary.write_text(activation_script(validate_session(session)), encoding="utf-8")
    temporary.replace(destination)
    return destination


class Panel:
    def __init__(self, session):
        self.session = session
        self.root = tk.Tk()
        self.root.title("MCPX Free")
        self.root.geometry("380x500")
        self.root.resizable(False, False)
        self.root.configure(bg=BACKGROUND)
        tk.Label(self.root, text="MCPX Free", font=("Segoe UI", 18, "bold"),
                 bg=BACKGROUND, fg=TEXT).pack(pady=(26, 5))
        tk.Label(self.root, text="DaVinci Resolve", font=("Segoe UI", 11),
                 bg=BACKGROUND, fg=MUTED).pack()
        self.power = tk.Canvas(self.root, width=146, height=146, bg=BACKGROUND,
                               highlightthickness=0, cursor="hand2")
        self.power.pack(pady=(23, 12))
        self.ring = self.power.create_oval(6, 6, 140, 140, outline=MUTED, width=2,
                                          fill=SURFACE)
        self.symbol = self.power.create_text(73, 70, text="⏻", fill=MUTED,
                                             font=("Segoe UI Symbol", 49))
        self.power.bind("<Button-1>", self.power_clicked)
        self.status = tk.Label(self.root, text="Comprobando…", font=("Segoe UI", 15, "bold"),
                               bg=BACKGROUND, fg=TEXT)
        self.status.pack()
        self.detail = tk.Label(self.root, text="", font=("Segoe UI", 10),
                               bg=BACKGROUND, fg=MUTED, wraplength=325, height=3)
        self.detail.pack(pady=(7, 9))
        tk.Button(self.root, text="Preparar botón en Resolve", command=self.install,
                  font=("Segoe UI", 10), bg=SURFACE, fg=TEXT, relief="flat",
                  activebackground="#293542", activeforeground=TEXT,
                  padx=18, pady=9, cursor="hand2").pack()
        tk.Button(self.root, text="Cambiar sesión", command=self.choose_session,
                  font=("Segoe UI", 9), bg=BACKGROUND, fg=MUTED, relief="flat",
                  activebackground=BACKGROUND, activeforeground=TEXT).pack(pady=8)
        self.active = False
        self.stopping = False
        self.failure = ""
        self.refresh()

    def refresh(self):
        self.active = heartbeat_state(self.session)
        try:
            self.failure = (self.session / "worker-error.txt").read_text(
                encoding="utf-8", errors="replace").strip()
        except OSError:
            self.failure = ""
        color = GREEN if self.active else MUTED
        self.power.itemconfigure(self.ring, outline=color)
        self.power.itemconfigure(self.symbol, fill=color)
        if self.stopping and self.active:
            self.status.configure(text="Desconectando…", fg=TEXT)
            self.detail.configure(text="Esperando al receptor de Resolve.")
        elif self.active:
            self.stopping = False
            self.status.configure(text="Puente activado", fg=GREEN)
            name, mode = worker_context(self.session)
            access = "Edición en proyecto de pruebas" if mode == "test" else "Solo lectura"
            self.detail.configure(text=f"{name or 'Abre un proyecto en Resolve'}\n{access}")
        else:
            self.stopping = False
            self.status.configure(text="Error al iniciar" if self.failure else "Puente desconectado", fg=TEXT)
            self.detail.configure(text="Pulsa para ver el detalle del error." if self.failure else
                                  "En Resolve abre Workspace → Scripts → MCPX Free.")
        self.root.after(750, self.refresh)

    def power_clicked(self, event=None):
        if not self.active:
            if self.failure:
                messagebox.showerror("Error de Resolve", self.failure, parent=self.root)
                return
            messagebox.showinfo("Activar MCPX Free",
                                "Abre tu proyecto en Resolve.\n\n"
                                "Selecciona Workspace → Scripts → MCPX Free.\n"
                                "Si todavía no aparece, pulsa Preparar botón en Resolve.",
                                parent=self.root)
            return
        try:
            # The private session directory is shared with the native Lua worker.
            (self.session / "stop.txt").write_text("stop\n", encoding="ascii")
            self.stopping = True
        except OSError as error:
            messagebox.showerror("MCPX Free", str(error), parent=self.root)

    def install(self):
        try:
            install_menu(self.session)
            messagebox.showinfo("Botón preparado",
                                "En Resolve abre Workspace → Scripts → MCPX Free.\n\n"
                                "Si el menú estaba abierto, ciérralo y vuelve a abrirlo. "
                                "Según la versión puede requerir reiniciar Resolve.",
                                parent=self.root)
        except (OSError, ValueError, KeyError) as error:
            messagebox.showerror("MCPX Free", str(error), parent=self.root)

    def choose_session(self):
        folder = filedialog.askdirectory(title="Sesión de MCPX Free", parent=self.root)
        if folder:
            try:
                session = validate_session(Path(folder))
                if self.active:
                    raise ValueError("Desconecta el receptor actual antes de cambiar de sesión.")
                self.session = session
            except (OSError, ValueError) as error:
                messagebox.showerror("MCPX Free", str(error), parent=self.root)

    def run(self):
        self.root.mainloop()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--session", type=Path, default=ROOT / ".scratch/private-ipc")
    parser.add_argument("--install", action="store_true")
    args = parser.parse_args()
    try:
        session = validate_session(args.session)
        prepare_status_files(session)
        if args.install:
            print(install_menu(session))
        else:
            Panel(session).run()
    except (OSError, ValueError, KeyError) as error:
        if args.install:
            print(str(error), file=sys.stderr)
            return 1
        root = tk.Tk()
        root.withdraw()
        messagebox.showerror("MCPX Free", str(error), parent=root)
        root.destroy()
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
